import cv2
import numpy as np
from PIL import Image, ImageDraw, ImageFont

# Load cascades
face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')
smile_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_smile.xml')

# Open webcam (use your camera index)
cap = cv2.VideoCapture(1)

# Path to a Tamil font on your system (change if needed)
# On macOS you can try this, or download a Tamil .ttf font and put the path here
font_path = "/System/Library/Fonts/Supplemental/Arial Unicode.ttf"
font_size = 30
font_color = (0, 255, 0)  # Green

# Load font
font = ImageFont.truetype(font_path, font_size)

def put_unicode_text(img, text, position, font, color):
    # Convert cv2 BGR image to PIL RGB
    img_pil = Image.fromarray(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    draw = ImageDraw.Draw(img_pil)
    draw.text(position, text, font=font, fill=color)
    # Convert back to cv2 BGR image
    img = cv2.cvtColor(np.array(img_pil), cv2.COLOR_RGB2BGR)
    return img

while True:
    ret, frame = cap.read()
    if not ret:
        break

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(gray, 1.1, 4)

    for (x, y, w, h) in faces:
        # Draw face rectangle
        cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)

        roi_gray = gray[y:y+h, x:x+w]
        smiles = smile_cascade.detectMultiScale(roi_gray, 1.8, 20)

        for (sx, sy, sw, sh) in smiles:
            # Draw smile rectangle
            cv2.rectangle(frame, (x+sx, y+sy), (x+sx+sw, y+sy+sh), (255, 0, 255), 2)
            # Put Tamil text using Pillow
            frame = put_unicode_text(frame, "கழுதை, ஏன் சிரிக்கிறாய்?", (x, y - 40), font, font_color)

    cv2.imshow('Smile Detector', frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
